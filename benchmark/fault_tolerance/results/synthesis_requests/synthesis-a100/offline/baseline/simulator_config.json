{
  "platform": {
    "accelerator": {
      "name": "a100_sxm",
      "hbm_capacity_gb": 80
    },
    "disk_read_bandwidth_gb": 8.0,
    "disk_write_bandwidth_gb": 8.0,
    "memory_read_bandwidth_gb": 64.0,
    "memory_write_bandwidth_gb": 64.0,
    "num_device_per_node": 8
  },
  "predictor": {
    "name": "aiconfigurator",
    "database_mode": "SILICON",
    "prefill_scale_factor": 1.0,
    "decode_scale_factor": 1.0
  },
  "scheduler": {
    "tp_size": 1,
    "pp_size": 1,
    "dp_size": 2,
    "backend_version": "0.5.9"
  },
  "failure": {
    "enabled": true,
    "backup_policy": "none",
    "failed_dp_rank": 0,
    "inject_after_job": 10,
    "inject_after_task": 0,
    "inject_delay_s": 5.0,
    "recover_after_job": 20,
    "recover_after_task": 0
  },
  "benchmark": {
    "suite": "synthesis-a100",
    "workload": "synthesis_requests",
    "execution_mode": "offline",
    "strategy": "baseline",
    "request_rate": "inf"
  }
