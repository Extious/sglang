                <mxCell id="tm6" value="simulate_gpu_recovery():&#10;  construct SimulateGpuRecoveryReqInput(dp_rank)&#10;  send_to_scheduler.send_pyobj(req) → ZMQ to DPC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
