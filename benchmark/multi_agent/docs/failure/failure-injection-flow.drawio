                <mxCell id="tm3" value="_handle_failover_batch():&#10;1. append_failover_event(&quot;failover_dispatched&quot;,&#10;   failed_dp_rank=N)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="900" y="1860" width="360" height="52" as="geometry"/>
