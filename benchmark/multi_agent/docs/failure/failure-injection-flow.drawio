                <mxCell id="dpc1" value="handle_simulate_gpu_failure():&#10;  failed_dp_ranks.add(N)&#10;  workers[N].send_pyobj(req) → ZMQ to scheduler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="1380" y="1150" width="360" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="dpc2" value="Dispatch: _request_excluded_dp_ranks(req)&#10;  exclude = set(failed_dp_ranks)&#10;  if req.failed_dp_rank: exclude.add(int(req.failed_dp_rank))&#10;dp_budget.dispatch(method, exclude=exclude)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="1380" y="2120" width="360" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="dpc2a" value="Filter: skip excluded ranks in dispatch&#10;  round_robin: advance from excluded to next healthy&#10;  total_tokens / total_requests: filter then select lowest&#10;  maybe_external_dp_rank_routing(): clear stale routed_dp_rank&#10;  If ALL ranks excluded → log error, drop request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5E6FF;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=8;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="1380" y="2210" width="360" height="80" as="geometry"/>
