                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="tm3a" value="For each ReqSnapshot in snapshots:&#10;  new_input_ids = origin_input_ids + output_ids&#10;  remaining_max = original_max_new_tokens - len(output_ids)&#10;  Construct TokenizedGenerateReqInput{&#10;    rid: snap.rid          (same client connection)&#10;    input_ids: new_input_ids&#10;    sampling_params: snap.sampling_params (reduced max_new_tokens)&#10;    failed_dp_rank: failover.failed_dp_rank&#10;    failover_prefix_ids: list(snap.output_ids)&#10;    pre_failover_output_tokens: len(snap.output_ids)&#10;    pre_failover_backed_up_tokens: snap.backed_up_tokens&#10;    stream: snap.stream&#10;  }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="900" y="1935" width="360" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="etm3_3a" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="tm3" target="tm3a" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="tm4" value="send_to_scheduler.send_pyobj(&#10;  retried TokenizedGenerateReqInput)&#10;  for each snapshot → ZMQ to DPC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
