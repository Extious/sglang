                <mxCell id="tm2" value="handle_loop() receives&#10;  FailoverBatchReqInput&#10;  from failed scheduler via ZMQ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
