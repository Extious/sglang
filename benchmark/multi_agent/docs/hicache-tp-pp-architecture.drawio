                            <mxPoint x="1090" y="170"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="pd_note" value="HiCache works on both Prefill and Decode nodes in PD mode.&#10;Each node can have its own TP/PP configuration.&#10;L3 enables cross-node KV cache reuse." style="rounded=1;whiteSpace=wrap;fillColor=#e0f2f1;strokeColor=#004d40;fontSize=10;align=left;spacingLeft=8;dashed=1;" parent="pd" vertex="1">
