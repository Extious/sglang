                <mxCell id="pov_key" value="Key Principle:&#10;Each PP stage has an INDEPENDENT HiCache instance.&#10;They do NOT share L1/L2 pools or HiRadixTree.&#10;L3 storage keys include pp_rank for data isolation." style="rounded=1;whiteSpace=wrap;fillColor=#fff9c4;strokeColor=#f57f17;fontSize=10;align=left;spacingLeft=8;" parent="pov" vertex="1">
