                <mxCell id="txp_summary" value="Summary:&#10;&#10;• PP partitions model layers across stages&#10;• Each PP stage has independent HiCache (tree, controller, L1, L2)&#10;• TP shards KV heads within each PP stage&#10;• all_reduce(MIN) syncs TP ranks within the same PP stage&#10;• L3 keys encode both tp_rank and pp_rank for full isolation&#10;• Cross-instance sharing happens only for same tp/pp topology" style="rounded=1;whiteSpace=wrap;fillColor=#ede7f6;strokeColor=#4527a0;fontSize=10;align=left;spacingLeft=10;spacingTop=3;" parent="txp" vertex="1">
                    <mxGeometry x="1300" y="45" width="480" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="pd" value="PD Disaggregation with HiCache" style="swimlane;startSize=26;fillColor=#e0f2f1;strokeColor=#00897b;fontStyle=1;fontSize=12;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1590" width="2400" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="pd_prefill" value="Prefill Node(s)&#10;&#10;HiCache enabled&#10;• Prefill computation&#10;• Write KV to L2 → L3&#10;• Transfer KV to decode" style="rounded=1;whiteSpace=wrap;fillColor=#b2dfdb;strokeColor=#00695c;fontSize=10;align=center;" parent="pd" vertex="1">
                    <mxGeometry x="80" y="40" width="280" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="pd_decode" value="Decode Node(s)&#10;&#10;HiCache enabled&#10;• Decode computation&#10;• Can write output KV to L3&#10;• Future reuse by prefill" style="rounded=1;whiteSpace=wrap;fillColor=#b2dfdb;strokeColor=#00695c;fontSize=10;align=center;" parent="pd" vertex="1">
                    <mxGeometry x="580" y="40" width="280" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="pd_arrow" value="MooncakeTransferEngine (RDMA)&#10;KV cache transfer" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#00695c;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontStyle=1;labelBackgroundColor=#e0f2f1;" parent="pd" source="pd_prefill" target="pd_decode" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pd_l3" value="L3 Shared Storage&#10;&#10;Prefill writes → Decode reads&#10;Decode writes → Prefill reuses&#10;DecodeKVCacheOffloadManager" style="rounded=1;whiteSpace=wrap;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=10;align=center;" parent="pd" vertex="1">
                    <mxGeometry x="1000" y="40" width="300" height="110" as="geometry"/>
