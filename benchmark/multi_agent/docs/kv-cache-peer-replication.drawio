                <mxCell id="p2_s2" value="② Prefill Compute&#10;→ KV in L1 (GPU)" style="rounded=1;whiteSpace=wrap;fillColor=#dcedc8;strokeColor=#558b2f;fontSize=10;align=center;" parent="p2_w0" vertex="1">
                    <mxGeometry x="120" y="27" width="155" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="p2_s3" value="③ Backup&#10;L1 → L2 (CPU)" style="rounded=1;whiteSpace=wrap;fillColor=#dcedc8;strokeColor=#558b2f;fontSize=10;align=center;" parent="p2_w0" vertex="1">
                    <mxGeometry x="295" y="27" width="120" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="p2_l1" value="L1: GPU VRAM" style="rounded=1;whiteSpace=wrap;fillColor=#dcedc8;strokeColor=#558b2f;fontSize=10;fontStyle=1;align=center;" parent="p2_w0" vertex="1">
                    <mxGeometry x="10" y="80" width="595" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="p2_l2" value="L2: CPU DRAM (HostKVCache)" style="rounded=1;whiteSpace=wrap;fillColor=#dcedc8;strokeColor=#558b2f;fontSize=10;fontStyle=1;align=center;" parent="p2_w0" vertex="1">
                    <mxGeometry x="10" y="128" width="595" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="p2_ctrl" value="④ backup_thread picks up pages" style="rounded=1;whiteSpace=wrap;fillColor=#dcedc8;strokeColor=#558b2f;fontSize=10;align=center;" parent="p2_w0" vertex="1">
                    <mxGeometry x="10" y="178" width="230" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="p2_ps" value="⑤ PeerCacheStorage&#10;batch_set_v1()" style="rounded=1;whiteSpace=wrap;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=10;fontStyle=1;align=center;" parent="p2_w0" vertex="1">
                    <mxGeometry x="260" y="178" width="170" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="p2_tcp" value="⑥ PeerCacheClient&#10;TCP PUT → W1:9001" style="rounded=1;whiteSpace=wrap;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=10;fontStyle=1;align=center;" parent="p2_w0" vertex="1">
                    <mxGeometry x="450" y="178" width="155" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="p2_sync" value="①-③: Synchronous (normal HiCache path)" style="text;html=1;align=left;fontSize=9;fontColor=#558b2f;fontStyle=2;" parent="p2_w0" vertex="1">
                    <mxGeometry x="10" y="225" width="300" height="16" as="geometry"/>
                </mxCell>
                <mxCell id="p2_async" value="④-⑥: Asynchronous (backup_thread, zero latency impact)" style="text;html=1;align=left;fontSize=9;fontColor=#e65100;fontStyle=2;" parent="p2_w0" vertex="1">
                    <mxGeometry x="10" y="243" width="380" height="16" as="geometry"/>
