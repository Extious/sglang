                <mxCell id="p6_ph4" value="Backend Registration&#10;StorageBackendFactory&#10;'peer' backend&#10;+ config integration" style="rounded=1;whiteSpace=wrap;fillColor=#e1bee7;strokeColor=#7b1fa2;fontSize=10;fontStyle=1;align=center;" parent="p6_phases" vertex="1">
