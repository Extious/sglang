                </mxCell>
                <mxCell id="p2_e5" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#e65100;strokeWidth=2;endArrow=block;endFill=1;dashed=1;" parent="p2_w0" source="p2_ps" target="p2_tcp" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_w1_prefill" value="Worker 1 (Neighbor)" style="swimlane;startSize=22;fillColor=#f5f5f5;strokeColor=#424242;fontStyle=1;fontSize=11;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="950" y="100" width="620" height="290" as="geometry"/>
                </mxCell>
                <mxCell id="p2_w1_srv" value="⑦ PeerCacheServer :9001&#10;Receives W0's pages via TCP" style="rounded=1;whiteSpace=wrap;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=10;fontStyle=1;align=center;" parent="p2_w1_prefill" vertex="1">
                    <mxGeometry x="10" y="40" width="595" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="p2_w1_buf" value="⑧ Store in PeerReplicaBuffer&#10;Dict[hash_key, page_data]  |  LRU eviction  |  max 8GB" style="rounded=1;whiteSpace=wrap;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=10;fontStyle=1;align=center;" parent="p2_w1_prefill" vertex="1">
                    <mxGeometry x="10" y="95" width="595" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="p2_w1_design" value="Key Design: Write path → REMOTE peer&#10;&#10;W0's batch_set_v1() reads from local L2&#10;host_pool.get_data_page(), serializes to bytes,&#10;sends via PeerCacheClient.put_pages() over TCP&#10;to Worker 1's PeerCacheServer" style="rounded=1;whiteSpace=wrap;fillColor=#fff3e0;strokeColor=#e65100;fontSize=10;align=left;spacingLeft=8;" parent="p2_w1_prefill" vertex="1">
                    <mxGeometry x="10" y="155" width="350" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p2_w1_read" value="Read path → LOCAL buffer (failover only)&#10;&#10;W1's batch_get_v1() reads from its own&#10;local_server.get_pages() and restores&#10;into host L2 via set_from_flat_data_page()" style="rounded=1;whiteSpace=wrap;fillColor=#fff3e0;strokeColor=#e65100;fontSize=10;align=left;spacingLeft=8;" parent="p2_w1_prefill" vertex="1">
                    <mxGeometry x="380" y="155" width="230" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p2_tcp_arrow" value="TCP PUT&#10;(async)" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#e65100;strokeWidth=4;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#e65100;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="p2_tcp" target="p2_w1_srv" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_decode_title" value="B. Decode Replication Path (via DecodeKVReplicator)" style="text;html=1;align=left;fontSize=14;fontStyle=1;fontColor=#1565c0;" parent="1" vertex="1">
                    <mxGeometry x="30" y="410" width="500" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="p2_decode_flow" value="" style="rounded=1;fillColor=#e3f2fd;strokeColor=#90caf9;container=1;" parent="1" vertex="1">
                    <mxGeometry x="30" y="440" width="1540" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="p2_d1" value="① Decode Step&#10;(scheduler)" style="rounded=1;whiteSpace=wrap;fillColor=#dcedc8;strokeColor=#558b2f;fontSize=10;fontStyle=1;align=center;" parent="p2_decode_flow" vertex="1">
                    <mxGeometry x="10" y="15" width="120" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="p2_d2" value="② on_decode_step()&#10;accumulate token&#10;+ device KV index" style="rounded=1;whiteSpace=wrap;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=10;fontStyle=1;align=center;" parent="p2_decode_flow" vertex="1">
                    <mxGeometry x="155" y="15" width="165" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="p2_d3" value="③ page_size tokens?&#10;_flush_page()" style="rhombus;whiteSpace=wrap;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=10;align=center;" parent="p2_decode_flow" vertex="1">
                    <mxGeometry x="345" y="5" width="155" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p2_d4" value="④ Compute page hashes&#10;get_hash_str(tokens,&#10;prior_hash) chaining" style="rounded=1;whiteSpace=wrap;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=10;align=center;" parent="p2_decode_flow" vertex="1">
                    <mxGeometry x="525" y="15" width="175" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="p2_d5" value="⑤ GPU→Host DMA&#10;cc.write(device_indices)" style="rounded=1;whiteSpace=wrap;fillColor=#dcedc8;strokeColor=#558b2f;fontSize=10;fontStyle=1;align=center;" parent="p2_decode_flow" vertex="1">
                    <mxGeometry x="725" y="15" width="165" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="p2_d6" value="⑥ DMA complete&#10;on_write_complete()" style="rounded=1;whiteSpace=wrap;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=10;fontStyle=1;align=center;" parent="p2_decode_flow" vertex="1">
                    <mxGeometry x="915" y="15" width="160" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="p2_d7" value="⑦ cc.write_storage()&#10;→ PeerCacheStorage&#10;→ TCP to neighbor" style="rounded=1;whiteSpace=wrap;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=10;fontStyle=1;align=center;" parent="p2_decode_flow" vertex="1">
                    <mxGeometry x="1100" y="15" width="160" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="p2_d8" value="⑧ PeerCacheServer&#10;stores in buffer" style="rounded=1;whiteSpace=wrap;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=10;fontStyle=1;align=center;" parent="p2_decode_flow" vertex="1">
                    <mxGeometry x="1290" y="15" width="140" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="p2_de1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#333;strokeWidth=2;endArrow=block;endFill=1;" parent="p2_decode_flow" source="p2_d1" target="p2_d2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_de2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1565c0;strokeWidth=2;endArrow=block;endFill=1;" parent="p2_decode_flow" source="p2_d2" target="p2_d3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_de3" value="Y" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1565c0;strokeWidth=2;endArrow=block;endFill=1;fontSize=9;fontStyle=1;" parent="p2_decode_flow" source="p2_d3" target="p2_d4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_de4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1565c0;strokeWidth=2;endArrow=block;endFill=1;" parent="p2_decode_flow" source="p2_d4" target="p2_d5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_de5" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1565c0;strokeWidth=2;endArrow=block;endFill=1;" parent="p2_decode_flow" source="p2_d5" target="p2_d6" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_de6" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#e65100;strokeWidth=2;endArrow=block;endFill=1;dashed=1;" parent="p2_decode_flow" source="p2_d6" target="p2_d7" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_de7" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#e65100;strokeWidth=2;endArrow=block;endFill=1;dashed=1;" parent="p2_decode_flow" source="p2_d7" target="p2_d8" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_d_key" value="Hash chaining: get_hash_str(page_tokens, prior_hash=parent_hash)&#10;Same algorithm as prefetch_from_storage → failover lookup HIT" style="rounded=1;whiteSpace=wrap;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=10;align=left;spacingLeft=8;" parent="p2_decode_flow" vertex="1">
                    <mxGeometry x="10" y="80" width="460" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="p2_d_flush" value="MIN_FLUSH_SIZE = 64 tokens&#10;flush_size = max(page_size, 64)&#10;Negative node IDs avoid collision with TreeNode" style="rounded=1;whiteSpace=wrap;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=10;align=left;spacingLeft=8;" parent="p2_decode_flow" vertex="1">
                    <mxGeometry x="490" y="80" width="340" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="p2_d_lifecycle" value="Lifecycle: created by HiRadixCache when backend='peer'&#10;on_decode_step() called by scheduler_output_processor_mixin&#10;on_request_finished() cleans up per-request state" style="rounded=1;whiteSpace=wrap;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=10;align=left;spacingLeft=8;" parent="p2_decode_flow" vertex="1">
                    <mxGeometry x="850" y="80" width="380" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="p2_d_wait" value="N (wait)" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#9e9e9e;strokeWidth=1;endArrow=block;endFill=1;fontSize=8;fontColor=#9e9e9e;exitX=0.5;exitY=1;entryX=0.5;entryY=1;curved=1;" parent="p2_decode_flow" source="p2_d3" target="p2_d2" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="423" y="80"/>
                            <mxPoint x="238" y="80"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p2_summary" value="Data Paths (both fully async, zero inference latency impact):&#10;Prefill: GPU → Host L2 → backup_thread → PeerCacheStorage.batch_set_v1() → TCP → Peer buffer&#10;Decode: GPU → DecodeKVReplicator → DMA → on_write_complete() → write_storage() → TCP → Peer buffer" style="rounded=1;whiteSpace=wrap;fillColor=#e8f5e9;strokeColor=#1b5e20;fontSize=11;align=left;spacingLeft=10;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="250" y="650" width="700" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="p2_lg1" value="" style="rounded=1;fillColor=#dcedc8;strokeColor=#558b2f;" parent="1" vertex="1">
                    <mxGeometry x="30" y="660" width="16" height="12" as="geometry"/>
                </mxCell>
                <mxCell id="p2_lg1t" value="EXISTING" style="text;html=1;align=left;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="50" y="657" width="70" height="16" as="geometry"/>
                </mxCell>
                <mxCell id="p2_lg2" value="" style="rounded=1;fillColor=#ffe0b2;strokeColor=#e65100;" parent="1" vertex="1">
                    <mxGeometry x="120" y="660" width="16" height="12" as="geometry"/>
                </mxCell>
                <mxCell id="p2_lg2t" value="Peer Storage" style="text;html=1;align=left;fontSize=9;fontStyle=1;fontColor=#e65100;" parent="1" vertex="1">
                    <mxGeometry x="140" y="657" width="80" height="16" as="geometry"/>
                </mxCell>
                <mxCell id="p2_lg3" value="" style="rounded=1;fillColor=#bbdefb;strokeColor=#1565c0;" parent="1" vertex="1">
                    <mxGeometry x="30" y="680" width="16" height="12" as="geometry"/>
                </mxCell>
                <mxCell id="p2_lg3t" value="DecodeKVReplicator" style="text;html=1;align=left;fontSize=9;fontStyle=1;fontColor=#1565c0;" parent="1" vertex="1">
                    <mxGeometry x="50" y="677" width="130" height="16" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram name="3. Failover Recovery Flow" id="p3">
        <mxGraphModel dx="744" dy="494" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p3_title" value="Failover Recovery: Worker 0 Failure" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1a237e;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="250" y="10" width="1100" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="p3_sub" value="When Worker 0 fails, PythonRouter redirects to Worker 1 which restores both prefill and decode KV from PeerReplicaBuffer" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#616161;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="150" y="42" width="1300" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="p3_flow" value="" style="rounded=1;fillColor=#fafafa;strokeColor=#e0e0e0;container=1;" parent="1" vertex="1">
                    <mxGeometry x="30" y="75" width="1540" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="p3_s1" value="① W0 Fails&#10;(crash/hang)" style="rounded=1;whiteSpace=wrap;fillColor=#ef9a9a;strokeColor=#b71c1c;fontSize=10;fontStyle=1;align=center;" parent="p3_flow" vertex="1">
                    <mxGeometry x="10" y="15" width="120" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="p3_s2" value="② Router&#10;health check&#10;detects" style="rounded=1;whiteSpace=wrap;fillColor=#e1bee7;strokeColor=#7b1fa2;fontSize=10;align=center;dashed=1;" parent="p3_flow" vertex="1">
                    <mxGeometry x="155" y="15" width="120" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="p3_s3" value="③ Ring failover&#10;→ Worker 1&#10;(i+1)%N" style="rounded=1;whiteSpace=wrap;fillColor=#e1bee7;strokeColor=#7b1fa2;fontSize=10;fontStyle=1;align=center;dashed=1;" parent="p3_flow" vertex="1">
                    <mxGeometry x="300" y="15" width="125" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="p3_s4" value="④ W1&#10;match_prefix()&#10;check L3" style="rounded=1;whiteSpace=wrap;fillColor=#dcedc8;strokeColor=#558b2f;fontSize=10;align=center;" parent="p3_flow" vertex="1">
                    <mxGeometry x="450" y="15" width="120" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="p3_s5" value="⑤ HIT!&#10;PeerBuffer has&#10;W0's KV data" style="rounded=1;whiteSpace=wrap;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=10;fontStyle=1;align=center;" parent="p3_flow" vertex="1">
                    <mxGeometry x="595" y="15" width="125" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="p3_s6" value="⑥ batch_get_v1()&#10;Buffer→L2" style="rounded=1;whiteSpace=wrap;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=10;align=center;" parent="p3_flow" vertex="1">
                    <mxGeometry x="745" y="15" width="110" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="p3_s7" value="⑦ Load&#10;L2→L1" style="rounded=1;whiteSpace=wrap;fillColor=#dcedc8;strokeColor=#558b2f;fontSize=10;align=center;" parent="p3_flow" vertex="1">
                    <mxGeometry x="880" y="15" width="100" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="p3_s8" value="⑧ Resume!&#10;Only compute&#10;new tokens" style="rounded=1;whiteSpace=wrap;fillColor=#c8e6c9;strokeColor=#1b5e20;fontSize=10;fontStyle=1;align=center;" parent="p3_flow" vertex="1">
                    <mxGeometry x="1005" y="15" width="130" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="p3_fe1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#b71c1c;strokeWidth=2;endArrow=block;endFill=1;" parent="p3_flow" source="p3_s1" target="p3_s2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3_fe2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#7b1fa2;strokeWidth=2;endArrow=block;endFill=1;" parent="p3_flow" source="p3_s2" target="p3_s3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3_fe3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#333;strokeWidth=2;endArrow=block;endFill=1;" parent="p3_flow" source="p3_s3" target="p3_s4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3_fe4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#333;strokeWidth=2;endArrow=block;endFill=1;" parent="p3_flow" source="p3_s4" target="p3_s5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3_fe5" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#e65100;strokeWidth=2;endArrow=block;endFill=1;" parent="p3_flow" source="p3_s5" target="p3_s6" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3_fe6" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#333;strokeWidth=2;endArrow=block;endFill=1;" parent="p3_flow" source="p3_s6" target="p3_s7" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3_fe7" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1b5e20;strokeWidth=2;endArrow=block;endFill=1;" parent="p3_flow" source="p3_s7" target="p3_s8" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3_note" value="②③ PythonRouter (ring failover)&#10;⑤⑥ PeerCacheStorage (local buffer read)" style="text;html=1;align=left;fontSize=9;fontColor=#616161;fontStyle=2;" parent="p3_flow" vertex="1">
                    <mxGeometry x="10" y="75" width="300" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p3_key_note" value="Content-addressed keys (SHA256 via get_hash_str with chaining)&#10;ensure same prefix = same key on any worker → HIT in buffer&#10;Works for both prefill pages and decode pages" style="text;html=1;align=left;fontSize=9;fontColor=#616161;fontStyle=2;" parent="p3_flow" vertex="1">
                    <mxGeometry x="580" y="70" width="420" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="p3_cmp_old" value="WITHOUT Peer Replication" style="swimlane;startSize=22;fillColor=#ffebee;strokeColor=#b71c1c;fontStyle=1;fontSize=12;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="30" y="230" width="750" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="p3_old_flow" value="W0 fails → Router retries on W1 → match_prefix() → MISS (no cached KV)&#10;→ Full re-prefill from scratch → O(prompt_length) compute" style="rounded=1;whiteSpace=wrap;fillColor=#ffcdd2;strokeColor=#c62828;fontSize=11;align=left;spacingLeft=10;" parent="p3_cmp_old" vertex="1">
                    <mxGeometry x="15" y="30" width="720" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p3_old_cost" value="Cost:  High latency  |  Wasted GPU compute  |  User-visible delay" style="text;html=1;align=center;fontSize=11;fontStyle=1;fontColor=#b71c1c;" parent="p3_cmp_old" vertex="1">
                    <mxGeometry x="15" y="90" width="720" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="p3_old_diag" value="W0 X -&gt; Router -&gt; W1 -&gt; match_prefix() -&gt; MISS -&gt; Full Prefill (slow)" style="text;html=1;align=center;fontSize=12;fontFamily=Courier New;fontColor=#b71c1c;" parent="p3_cmp_old" vertex="1">
                    <mxGeometry x="15" y="130" width="720" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="p3_old_time" value="Recovery time: seconds to minutes (depends on prompt length)" style="text;html=1;align=center;fontSize=10;fontColor=#b71c1c;" parent="p3_cmp_old" vertex="1">
                    <mxGeometry x="15" y="165" width="720" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="p3_cmp_new" value="WITH Peer Replication (Prefill + Decode)" style="swimlane;startSize=22;fillColor=#e8f5e9;strokeColor=#1b5e20;fontStyle=1;fontSize=12;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="820" y="230" width="750" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="p3_new_flow" value="W0 fails → Router (ring) → W1 → match_prefix() → HIT in PeerReplicaBuffer&#10;→ Restore both prefill AND decode KV from buffer → Resume from cache" style="rounded=1;whiteSpace=wrap;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=11;align=left;spacingLeft=10;" parent="p3_cmp_new" vertex="1">
                    <mxGeometry x="15" y="30" width="720" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p3_new_cost" value="Cost:  O(1) memory copy  |  Near-zero latency  |  Transparent to user" style="text;html=1;align=center;fontSize=11;fontStyle=1;fontColor=#1b5e20;" parent="p3_cmp_new" vertex="1">
                    <mxGeometry x="15" y="90" width="720" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="p3_new_diag" value="W0 X -&gt; Router -&gt; W1 -&gt; match_prefix() -&gt; HIT -&gt; Restore -&gt; Resume (fast)" style="text;html=1;align=center;fontSize=12;fontFamily=Courier New;fontColor=#1b5e20;" parent="p3_cmp_new" vertex="1">
                    <mxGeometry x="15" y="130" width="720" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="p3_new_time" value="Recovery time: milliseconds (memory copy only, no re-prefill needed)" style="text;html=1;align=center;fontSize=10;fontColor=#1b5e20;" parent="p3_cmp_new" vertex="1">
                    <mxGeometry x="15" y="165" width="720" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="p3_arrow" value="" style="shape=mxgraph.arrows2.arrow;dy=0.6;dx=40;notch=0;fillColor=#1b5e20;strokeColor=none;rotation=-90;" parent="1" vertex="1">
                    <mxGeometry x="775" y="290" width="30" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p3_benefit" value="Key Benefit: Recovery time drops from seconds/minutes to milliseconds (both prefill + decode KV preserved)" style="rounded=1;whiteSpace=wrap;fillColor=#1b5e20;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#fff;align=center;" parent="1" vertex="1">
                    <mxGeometry x="200" y="470" width="750" height="40" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram name="4. Component Design" id="p4">
        <mxGraphModel dx="893" dy="593" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p4_title" value="Component Design: PeerCacheServer, PeerCacheStorage, DecodeKVReplicator" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1a237e;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="100" y="10" width="1400" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p4_srv" value="PeerCacheServer + PeerCacheClient" style="swimlane;startSize=22;fillColor=#fff3e0;strokeColor=#e65100;fontStyle=1;fontSize=11;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="30" y="50" width="760" height="440" as="geometry"/>
                </mxCell>
                <mxCell id="p4_srv_loc" value="python/sglang/srt/mem_cache/storage/peer/peer_cache_server.py" style="text;html=1;align=left;fontSize=9;fontStyle=2;fontColor=#616161;" parent="p4_srv" vertex="1">
                    <mxGeometry x="10" y="25" width="500" height="16" as="geometry"/>
                </mxCell>
                <mxCell id="p4_srv_cls" value="class PeerCacheServer:&#10;&#10;  def __init__(port, max_buffer_size_gb=8.0):&#10;      self.buffer: Dict[str, bytes]&#10;      self.lru: OrderedDict&#10;      self.lock: threading.Lock&#10;      self.max_size: int  # bytes&#10;      self.current_size: int&#10;&#10;  def start() → ThreadingTCPServer daemon&#10;  def stop()&#10;  def put_pages(keys, pages) → List[bool]&#10;  def get_pages(keys) → List[Optional[bytes]]&#10;  def exists(keys) → int  # consecutive hits&#10;  def clear()&#10;  def _evict_if_needed()  # LRU eviction" style="rounded=1;whiteSpace=wrap;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=9;align=left;spacingLeft=10;spacingTop=3;fontFamily=Courier New;" parent="p4_srv" vertex="1">
                    <mxGeometry x="10" y="45" width="370" height="235" as="geometry"/>
                </mxCell>
                <mxCell id="p4_cli_cls" value="class PeerCacheClient:&#10;&#10;  def __init__(peer_url: str):&#10;      self.host, self.port&#10;      self._sock: Optional[socket]&#10;      self._lock: threading.Lock&#10;&#10;  def _connect() → socket  # TCP_NODELAY&#10;  def _reset()  # close on error&#10;  def put_pages(keys, pages) → List[bool]&#10;  def close()" style="rounded=1;whiteSpace=wrap;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=9;align=left;spacingLeft=10;spacingTop=3;fontFamily=Courier New;" parent="p4_srv" vertex="1">
                    <mxGeometry x="10" y="295" width="370" height="135" as="geometry"/>
                </mxCell>
                <mxCell id="p4_srv_info" value="Threading:&#10;Server: ThreadingTCPServer (0.0.0.0:port)&#10;  one daemon thread per connection&#10;Client: single persistent TCP connection&#10;  guarded by threading.Lock&#10;Port: peer_port_base + gpu_id (default 9000)" style="rounded=1;whiteSpace=wrap;fillColor=#fff;strokeColor=#bdbdbd;fontSize=9;align=left;spacingLeft=8;" parent="p4_srv" vertex="1">
                    <mxGeometry x="400" y="45" width="340" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p4_srv_lru" value="LRU Eviction:&#10;put → insert/update at end (move_to_end)&#10;get → move to end&#10;overflow → popitem(last=False) evict oldest&#10;current_size tracks total bytes used" style="rounded=1;whiteSpace=wrap;fillColor=#fff;strokeColor=#bdbdbd;fontSize=9;align=left;spacingLeft=8;" parent="p4_srv" vertex="1">
                    <mxGeometry x="400" y="155" width="340" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p4_srv_proto" value="Binary TCP Protocol:&#10;Header: [cmd:1B][count:4B] (big-endian !BI)&#10;Per item: [key_len:4B][key][data_len:4B][data]&#10;&#10;PUT  cmd=1  send keys+pages, recv ok per item&#10;GET  cmd=2  send keys, recv found flags + data&#10;EXISTS cmd=3  send keys, recv consecutive count" style="rounded=1;whiteSpace=wrap;fillColor=#fff;strokeColor=#bdbdbd;fontSize=9;align=left;spacingLeft=8;fontFamily=Courier New;" parent="p4_srv" vertex="1">
                    <mxGeometry x="400" y="260" width="340" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p4_sto" value="PeerCacheStorage (HiCacheStorage backend)" style="swimlane;startSize=22;fillColor=#fff3e0;strokeColor=#e65100;fontStyle=1;fontSize=11;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="810" y="50" width="760" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="p4_sto_loc" value="python/sglang/srt/mem_cache/storage/peer/peer_cache_storage.py" style="text;html=1;align=left;fontSize=9;fontStyle=2;fontColor=#616161;" parent="p4_sto" vertex="1">
                    <mxGeometry x="10" y="25" width="500" height="16" as="geometry"/>
                </mxCell>
                <mxCell id="p4_sto_cls" value="class PeerCacheStorage(HiCacheStorage):&#10;&#10;  def __init__(storage_config, mem_pool_host):&#10;      self.local_server: PeerCacheServer&#10;      self.peer_client: PeerCacheClient | None&#10;      self.mem_pool_host  # HostKVCache ref&#10;      self.page_size&#10;&#10;  def batch_set_v1(keys, host_indices)&#10;  def batch_get_v1(keys, host_indices)&#10;  def batch_exists(keys) → int" style="rounded=1;whiteSpace=wrap;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=9;align=left;spacingLeft=10;spacingTop=3;fontFamily=Courier New;" parent="p4_sto" vertex="1">
                    <mxGeometry x="10" y="45" width="370" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="p4_sto_key" value="Core Asymmetry" style="swimlane;startSize=18;fillColor=#fff9c4;strokeColor=#f57f17;fontStyle=1;fontSize=10;rounded=1;" parent="p4_sto" vertex="1">
                    <mxGeometry x="400" y="45" width="340" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="p4_sto_key_d" value="WRITE (batch_set_v1):&#10;  → REMOTE: sends to neighbor&#10;  host_pool.get_data_page(idx) → tobytes()&#10;  → peer_client.put_pages() → TCP&#10;&#10;READ (batch_get_v1):&#10;  → LOCAL: reads own buffer&#10;  local_server.get_pages(keys)&#10;  → torch.frombuffer() → set_from_flat_data_page()&#10;&#10;EXISTS (batch_exists):&#10;  → LOCAL: local_server.exists(keys)" style="rounded=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=9;align=left;spacingLeft=6;" parent="p4_sto_key" vertex="1">
                    <mxGeometry x="5" y="20" width="330" height="148" as="geometry"/>
                </mxCell>
                <mxCell id="p4_dkr" value="DecodeKVReplicator" style="swimlane;startSize=22;fillColor=#e3f2fd;strokeColor=#1565c0;fontStyle=1;fontSize=11;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="810" y="325" width="760" height="380" as="geometry"/>
                </mxCell>
                <mxCell id="p4_dkr_loc" value="python/sglang/srt/mem_cache/decode_kv_replicator.py" style="text;html=1;align=left;fontSize=9;fontStyle=2;fontColor=#616161;" parent="p4_dkr" vertex="1">
                    <mxGeometry x="10" y="25" width="500" height="16" as="geometry"/>
                </mxCell>
                <mxCell id="p4_dkr_cls" value="class DecodeKVReplicator:&#10;  MIN_FLUSH_SIZE = 64&#10;&#10;  def __init__(cache_controller,&#10;               req_to_token_pool,&#10;               page_size, tree_cache):&#10;      self._cc: HiCacheController&#10;      self._states: Dict[str, _ReqState]&#10;      self._pending_dma: Dict[int, _PendingPage]&#10;      self._node_id_counter = -(10**9)&#10;&#10;  def on_decode_step(batch) → None&#10;  def _flush_page(rid, state) → None&#10;  def on_write_complete(node_id) → bool&#10;  def on_request_finished(req) → None&#10;  def set_prefill_parent_hash(req, hash)" style="rounded=1;whiteSpace=wrap;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=9;align=left;spacingLeft=10;spacingTop=3;fontFamily=Courier New;" parent="p4_dkr" vertex="1">
                    <mxGeometry x="10" y="45" width="370" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="p4_dkr_ds" value="Data Structures:&#10;&#10;@dataclass _ReqState:&#10;  token_ids: List[int]&#10;  device_indices: List[int]&#10;  parent_hash: Optional[str]&#10;  pages_flushed: int&#10;&#10;@dataclass _PendingPage:&#10;  page_hash: List[str]&#10;  host_indices: Tensor&#10;  node_id: int" style="rounded=1;whiteSpace=wrap;fillColor=#fff;strokeColor=#bdbdbd;fontSize=9;align=left;spacingLeft=8;fontFamily=Courier New;" parent="p4_dkr" vertex="1">
                    <mxGeometry x="400" y="45" width="340" height="185" as="geometry"/>
                </mxCell>
                <mxCell id="p4_dkr_flow" value="Flow per decode step:&#10;1. Accumulate token_id + device KV index&#10;2. When flush_size tokens ready → _flush_page()&#10;3. Compute page hashes via get_hash_str() chaining&#10;4. GPU→Host DMA via cc.write(device_indices)&#10;5. On DMA complete → cc.write_storage() → TCP peer" style="rounded=1;whiteSpace=wrap;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=9;align=left;spacingLeft=8;" parent="p4_dkr" vertex="1">
                    <mxGeometry x="400" y="245" width="340" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="p4_dkr_note" value="Why needed: During decode, KV lives only in GPU&#10;KV pool, NOT in radix tree. Normal backup_thread&#10;only handles radix tree nodes. DecodeKVReplicator&#10;bypasses the tree and replicates directly." style="rounded=1;whiteSpace=wrap;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=9;align=left;spacingLeft=8;" parent="p4_dkr" vertex="1">
                    <mxGeometry x="10" y="300" width="370" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p4_sto_reg" value="StorageBackendFactory Registration" style="swimlane;startSize=18;fillColor=#fff;strokeColor=#e65100;fontStyle=1;fontSize=10;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="30" y="505" width="760" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="p4_sto_reg_d" value="StorageBackendFactory.register_backend(&#10;    &quot;peer&quot;,&#10;    &quot;sglang.srt.mem_cache.storage.peer.peer_cache_storage&quot;,&#10;    &quot;PeerCacheStorage&quot;)&#10;&#10;Creation: backend_class(storage_config, mem_pool_host)" style="rounded=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=9;align=left;spacingLeft=6;fontFamily=Courier New;" parent="p4_sto_reg" vertex="1">
                    <mxGeometry x="5" y="20" width="740" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="p4_cfg" value="Configuration (env vars / extra_config)" style="swimlane;startSize=18;fillColor=#fff;strokeColor=#e65100;fontStyle=1;fontSize=10;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="30" y="605" width="760" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p4_cfg_d" value="SGLANG_PEER_CACHE_PORT    (default 9000)   → PeerCacheServer listen port&#10;SGLANG_PEER_TARGET_URL    (e.g. host:9001) → PeerCacheClient target (empty=receive-only)&#10;SGLANG_PEER_BUFFER_SIZE_GB (default 8)      → max DRAM buffer per worker&#10;&#10;Also configurable via --hicache-storage-backend-extra-config '{&quot;peer_port&quot;: 9000, &quot;peer_url&quot;: &quot;host:9001&quot;}'" style="rounded=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=9;align=left;spacingLeft=6;fontFamily=Courier New;" parent="p4_cfg" vertex="1">
                    <mxGeometry x="5" y="20" width="740" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="p4_arrow" value="PeerCacheStorage creates both&#10;PeerCacheServer + PeerCacheClient" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#e65100;strokeWidth=2;endArrow=block;endFill=1;fontSize=9;fontColor=#e65100;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="p4_sto" target="p4_srv" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1190" y="320"/>
                            <mxPoint x="800" y="320"/>
                            <mxPoint x="800" y="40"/>
                            <mxPoint x="410" y="40"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram name="5. PythonRouter Modifications" id="p5">
        <mxGraphModel dx="891" dy="492" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p5_title" value="PythonRouter: Ring Failover Modifications" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1a237e;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="250" y="10" width="1100" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="p5_sub" value="benchmark/multi_agent/src/router/python_router.py" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#616161;fontStyle=2;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="400" y="42" width="800" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="p5_existing" value="Existing PythonRouter (EXISTING)" style="swimlane;startSize=24;fillColor=#dcedc8;strokeColor=#558b2f;fontStyle=1;fontSize=12;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="30" y="75" width="520" height="420" as="geometry"/>
                </mxCell>
                <mxCell id="p5_cls" value="class PythonRouter:" style="text;html=1;align=left;fontSize=11;fontStyle=1;fontFamily=Courier New;" parent="p5_existing" vertex="1">
                    <mxGeometry x="10" y="28" width="300" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="p5_sw" value="select_worker(request_text)&#10;|- cache-aware: RadixTree prefix match&#10;|- load balancing: shortest queue&#10;|- returns worker index" style="rounded=1;whiteSpace=wrap;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=10;align=left;spacingLeft=8;" parent="p5_existing" vertex="1">
                    <mxGeometry x="10" y="52" width="495" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="p5_hc" value="_health_loop()&#10;|- periodic /health GET to each worker&#10;|- failure_threshold → mark unhealthy&#10;|- success_threshold → mark healthy" style="rounded=1;whiteSpace=wrap;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=10;align=left;spacingLeft=8;" parent="p5_existing" vertex="1">
                    <mxGeometry x="10" y="128" width="495" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="p5_retry" value="_proxy_non_stream() / _proxy_stream()&#10;|- retry with exponential backoff + jitter&#10;|- excluded set: skip failed workers&#10;|- chunk_timeout_secs: idle timeout&#10;|- retry_max_retries: max attempts" style="rounded=1;whiteSpace=wrap;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=10;align=left;spacingLeft=8;" parent="p5_existing" vertex="1">
                    <mxGeometry x="10" y="205" width="495" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="p5_cfg_box" value="RouterConfig&#10;|- worker_urls, cache_threshold&#10;|- balance_abs/rel_threshold&#10;|- health_check/retry params&#10;|- chunk_timeout_secs" style="rounded=1;whiteSpace=wrap;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=10;align=left;spacingLeft=8;" parent="p5_existing" vertex="1">
                    <mxGeometry x="10" y="302" width="495" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="p5_modify" value="Ring Failover Modifications (MODIFY)" style="swimlane;startSize=24;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontStyle=1;fontSize=12;rounded=1;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="580" y="75" width="540" height="420" as="geometry"/>
                </mxCell>
                <mxCell id="p5_m_cfg" value="RouterConfig (ADD fields):" style="text;html=1;align=left;fontSize=10;fontStyle=1;fontColor=#7b1fa2;" parent="p5_modify" vertex="1">
                    <mxGeometry x="10" y="28" width="300" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="p5_m_cfg_d" value="+ enable_fault_tolerance: bool = False&#10;  # Master switch for peer replication&#10;  # When True → failover_strategy = &quot;ring&quot;&#10;+ CLI: --enable-fault-tolerance" style="rounded=1;whiteSpace=wrap;fillColor=#e1bee7;strokeColor=#7b1fa2;fontSize=10;align=left;spacingLeft=8;fontFamily=Courier New;dashed=1;" parent="p5_modify" vertex="1">
                    <mxGeometry x="10" y="50" width="515" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="p5_m_sw" value="select_worker() (MODIFY logic):" style="text;html=1;align=left;fontSize=10;fontStyle=1;fontColor=#7b1fa2;" parent="p5_modify" vertex="1">
                    <mxGeometry x="10" y="115" width="300" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="p5_m_sw_d" value="+ Add failed_worker_idx parameter&#10;+ If enable_fault_tolerance and&#10;  failed_worker_idx is not None:&#10;    ring_target = (failed_worker_idx + 1) % N&#10;    if ring_target healthy → route there&#10;    and insert into radix tree&#10;+ Else: existing cache-aware logic" style="rounded=1;whiteSpace=wrap;fillColor=#e1bee7;strokeColor=#7b1fa2;fontSize=10;align=left;spacingLeft=8;dashed=1;" parent="p5_modify" vertex="1">
                    <mxGeometry x="10" y="145" width="515" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="p5_m_retry" value="_proxy retry logic (MODIFY):" style="text;html=1;align=left;fontSize=10;fontStyle=1;fontColor=#7b1fa2;" parent="p5_modify" vertex="1">
                    <mxGeometry x="10" y="258" width="300" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="p5_m_retry_d" value="+ When worker fails and added to excluded:&#10;  pass failed_worker_idx to select_worker()&#10;+ Ring mode: next retry goes to neighbor&#10;  (which has the failed worker's KV replicas)&#10;+ Falls back to shortest-queue if neighbor&#10;  is also unhealthy" style="rounded=1;whiteSpace=wrap;fillColor=#e1bee7;strokeColor=#7b1fa2;fontSize=10;align=left;spacingLeft=8;dashed=1;" parent="p5_modify" vertex="1">
                    <mxGeometry x="10" y="278" width="515" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p5_flow" value="Ring Failover Decision Flow" style="swimlane;startSize=22;fillColor=#fafafa;strokeColor=#bdbdbd;fontStyle=1;fontSize=11;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="1150" y="75" width="420" height="420" as="geometry"/>
                </mxCell>
                <mxCell id="p5_f1" value="Worker i fails" style="rounded=1;whiteSpace=wrap;fillColor=#ef9a9a;strokeColor=#b71c1c;fontSize=10;fontStyle=1;align=center;" parent="p5_flow" vertex="1">
                    <mxGeometry x="140" y="30" width="140" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="p5_f2" value="enable_fault\n_tolerance?" style="rhombus;whiteSpace=wrap;fillColor=#e1bee7;strokeColor=#7b1fa2;fontSize=10;align=center;" parent="p5_flow" vertex="1">
                    <mxGeometry x="125" y="85" width="170" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p5_f3y" value="Prefer W(i+1)%N" style="rounded=1;whiteSpace=wrap;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=10;fontStyle=1;align=center;" parent="p5_flow" vertex="1">
                    <mxGeometry x="10" y="175" width="160" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="p5_f3n" value="Any healthy worker&#10;(shortest queue)" style="rounded=1;whiteSpace=wrap;fillColor=#dcedc8;strokeColor=#558b2f;fontSize=10;align=center;" parent="p5_flow" vertex="1">
                    <mxGeometry x="240" y="175" width="165" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="p5_f4" value="W(i+1) healthy?" style="rhombus;whiteSpace=wrap;fillColor=#e1bee7;strokeColor=#7b1fa2;fontSize=10;align=center;" parent="p5_flow" vertex="1">
                    <mxGeometry x="15" y="235" width="150" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p5_f5y" value="Route to W(i+1)&#10;→ PeerBuffer HIT" style="rounded=1;whiteSpace=wrap;fillColor=#c8e6c9;strokeColor=#1b5e20;fontSize=10;fontStyle=1;align=center;" parent="p5_flow" vertex="1">
                    <mxGeometry x="10" y="315" width="160" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="p5_f5n" value="Fall back to&#10;shortest-queue" style="rounded=1;whiteSpace=wrap;fillColor=#dcedc8;strokeColor=#558b2f;fontSize=10;align=center;" parent="p5_flow" vertex="1">
                    <mxGeometry x="240" y="315" width="165" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="p5_fe1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#333;strokeWidth=2;endArrow=block;endFill=1;" parent="p5_flow" source="p5_f1" target="p5_f2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5_fe2y" value="Y" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#7b1fa2;strokeWidth=2;endArrow=block;endFill=1;fontSize=9;fontStyle=1;" parent="p5_flow" source="p5_f2" target="p5_f3y" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5_fe2n" value="N" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#558b2f;strokeWidth=2;endArrow=block;endFill=1;fontSize=9;fontStyle=1;" parent="p5_flow" source="p5_f2" target="p5_f3n" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5_fe3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#333;strokeWidth=2;endArrow=block;endFill=1;" parent="p5_flow" source="p5_f3y" target="p5_f4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5_fe4y" value="Y" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1b5e20;strokeWidth=2;endArrow=block;endFill=1;fontSize=9;fontStyle=1;" parent="p5_flow" source="p5_f4" target="p5_f5y" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5_fe4n" value="N" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#558b2f;strokeWidth=2;endArrow=block;endFill=1;fontSize=9;fontStyle=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" parent="p5_flow" source="p5_f4" target="p5_f5n" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
