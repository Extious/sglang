                    <mxGeometry x="40" y="80" width="520" height="320" as="geometry"/>
                </mxCell>
                <mxCell id="p3_dpc_d" value="TrackedGenerateRequest (dataclass):&#10;  tokenized_req, owner_dp_rank, backup_dp_rank,&#10;  visible_output_ids, checkpointed_output_len,&#10;  failover_epoch, failover_supported, failover_completed&#10;&#10;_should_enable_internal_failover():&#10;  dp_size&gt;1 AND storage=peer AND pp_async_batch_depth==0&#10;&#10;_poll_failed_worker_groups():&#10;  Detect scheduler subprocess exit → mark failed&#10;&#10;_handle_failed_dp_rank(failed_dp_rank):&#10;  Collect tracked requests → build ResumeGenerateReq&#10;  → dispatch to backup_dp_rank scheduler&#10;  With: min(checkpointed_len, len(visible_ids))&#10;&#10;handle_checkpoint_update_req(): update tracked state&#10;handle_visible_state_update_req(): extend visible_ids&#10;&#10;maybe_external_dp_rank_routing():&#10;  Reroute to backup when target rank is dead" style="rounded=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=10;align=left;spacingLeft=8;spacingTop=2;" vertex="1" parent="p3_dpc">
                    <mxGeometry x="6" y="26" width="508" height="288" as="geometry"/>
                </mxCell>
                <mxCell id="p3_sch" value="scheduler.py (+533 lines)" style="swimlane;startSize=22;fillColor=#e3f2fd;strokeColor=#1565c0;fontStyle=1;fontSize=12;rounded=1;" vertex="1" parent="1">
                    <mxGeometry x="590" y="80" width="520" height="320" as="geometry"/>
                </mxCell>
                <mxCell id="p3_sch_d" value="handle_resume_generate_request(req):&#10;  Reconstruct input_ids = original + visible_output_ids&#10;  Adjust max_new_tokens, set is_failover_resume=True&#10;  Route through handle_generate_request()&#10;  Dedup via handled_resume_epochs[rid]&#10;&#10;maybe_send_checkpoint_updates():&#10;  Only from last PP stage (leader)&#10;  pop_pending_checkpoint_rids → TP MIN allreduce&#10;  → send CheckpointUpdateReq to DPC&#10;&#10;_should_prefetch_storage_for_req(req):&#10;  PP=1: standard storage prefetch&#10;  PP&gt;1: only if _is_pp_storage_resume&#10;    (failover + resume_visible_output_len&gt;0)&#10;&#10;_should_wait_for_storage_prefetch(req):&#10;  hicache_storage AND is_failover_resume&#10;&#10;Waiting queue: failover resume gets priority;&#10;  PP storage resume blocks at queue head" style="rounded=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=10;align=left;spacingLeft=8;spacingTop=2;" vertex="1" parent="p3_sch">
                    <mxGeometry x="6" y="26" width="508" height="288" as="geometry"/>
                </mxCell>
                <mxCell id="p3_tok" value="tokenizer_manager.py (+71 lines)" style="swimlane;startSize=22;fillColor=#e3f2fd;strokeColor=#1565c0;fontStyle=1;fontSize=12;rounded=1;" vertex="1" parent="1">
                    <mxGeometry x="1140" y="80" width="360" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="p3_tok_d" value="_maybe_publish_visible_state_update():&#10;  When dp_size&gt;1: send VisibleStateUpdateReq&#10;  with output_ids_delta + finished flag&#10;  Called from _handle_batch_output()&#10;&#10;_handle_reset_visible_state_req():&#10;  Clear streaming/text/output/logprob state&#10;  for a rid (no-backup reroute scenario)&#10;&#10;Forward CheckpointUpdateReq to scheduler" style="rounded=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=10;align=left;spacingLeft=8;spacingTop=2;" vertex="1" parent="p3_tok">
                    <mxGeometry x="6" y="26" width="348" height="168" as="geometry"/>
                </mxCell>
                <mxCell id="p3_hcc" value="cache_controller.py (+206 lines)" style="swimlane;startSize=22;fillColor=#e3f2fd;strokeColor=#1565c0;fontStyle=1;fontSize=12;rounded=1;" vertex="1" parent="1">
                    <mxGeometry x="40" y="430" width="520" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="p3_hcc_d" value="_page_transfer_tokens():&#10;  Token-level page fetch from peer radix buffer&#10;  Handles gaps/eviction gracefully (skip, don't fail)&#10;&#10;_storage_hit_query_tokens():&#10;  storage.match_prefix_from() + get_pages_tokens()&#10;  Token prefix matching (parallel to hash-based query)&#10;&#10;_page_backup() enhanced:&#10;  HiCacheStorageExtraInfo carries full_token_ids + page_start&#10;  Supports token-based write path to PeerCacheStorage&#10;&#10;Peer-specific zero-copy path:&#10;  batch_get_v1 / batch_set_v1 for peer backend" style="rounded=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=10;align=left;spacingLeft=8;spacingTop=2;" vertex="1" parent="p3_hcc">
