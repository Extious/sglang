                    <mxGeometry x="30" y="346" width="360" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="p4_bk_get" value="get_pages_by_tokens()&#10;→ load KV data into Host L2" style="rounded=1;whiteSpace=wrap;fillColor=#fff3e0;strokeColor=#ef6c00;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="p4_backup">
                    <mxGeometry x="30" y="416" width="360" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="p4_bk_load" value="Normal HiCache path:&#10;Host L2 → GPU L1&#10;Resume generation" style="rounded=1;whiteSpace=wrap;fillColor=#dcedc8;strokeColor=#558b2f;fontSize=10;align=center;" vertex="1" parent="p4_backup">
                    <mxGeometry x="30" y="486" width="360" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="p4_bke1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2e7d32;strokeWidth=1;endArrow=block;endFill=1;" edge="1" parent="p4_backup" source="p4_bk_recv" target="p4_bk_insert">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4_bke2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2e7d32;strokeWidth=1;endArrow=block;endFill=1;" edge="1" parent="p4_backup" source="p4_bk_insert" target="p4_bk_trie">
                    <mxGeometry relative="1" as="geometry"/>
