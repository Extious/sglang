    <diagram name="7. KV Transfer Topology (Clean)" id="p7">
        <mxGraphModel dx="1600" dy="1060" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1060" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>

                <!-- ===== Title ===== -->
                <mxCell id="p7_title" value="KV Cache Peer Replication: Data Transfer Topology (DP=2, PP=2, TP=1)" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1a237e;strokeColor=none;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="100" y="10" width="1400" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p7_sub" value="Layout: rows = PP stages, columns = DP replicas. Replication always horizontal (same PP, next DP). Ring: backup_dp = (dp+1) % dp_size." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#616161;strokeColor=none;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="100" y="42" width="1400" height="20" as="geometry"/>
                </mxCell>

                <!-- ===== Head Server ===== -->
                <mxCell id="p7_head" value="Head Server: TokenizerManager + DataParallelController&#10;HTTP :28000 | Request dispatch | Checkpoint &amp; visible state tracking | Internal failover" style="rounded=1;whiteSpace=wrap;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="1">
                    <mxGeometry x="380" y="72" width="840" height="48" as="geometry"/>
                </mxCell>

                <!-- ===== DP0 / PP0 — Stage (0,0,0) ===== -->
                <mxCell id="p7_00" value="Stage (0,0,0) — scheduler_DP0_PP0" style="swimlane;startSize=24;fillColor=#fafafa;strokeColor=#1565c0;fontStyle=1;fontSize=12;rounded=1;" vertex="1" parent="1">
                    <mxGeometry x="40" y="160" width="660" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="p7_00_cache" value="L1: GPU VRAM (KV Pool)  →  L2: Host DRAM (HiCache backup_thread)" style="rounded=1;whiteSpace=wrap;fillColor=#dcedc8;strokeColor=#558b2f;fontSize=10;align=center;" vertex="1" parent="p7_00">
                    <mxGeometry x="15" y="32" width="630" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="p7_00_dkr" value="DecodeKVReplicator: on_decode_step → flush_page → GPU DMA → write_storage" style="rounded=1;whiteSpace=wrap;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=9;fontStyle=1;align=center;" vertex="1" parent="p7_00">
                    <mxGeometry x="15" y="68" width="630" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="p7_00_send" value="SEND ▸  PeerCacheClient → TCP (CMD_PUT_TOKENS) → Stage(1,0,0) :29002" style="rounded=1;whiteSpace=wrap;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="p7_00">
                    <mxGeometry x="15" y="100" width="630" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p7_00_recv" value="RECV ◂  PeerCacheServer :29000 ← from Stage(1,0,0)  |  PeerRadixBuffer (token trie, LRU)" style="rounded=1;whiteSpace=wrap;fillColor=#fff3e0;strokeColor=#ef6c00;fontSize=10;align=center;" vertex="1" parent="p7_00">
                    <mxGeometry x="15" y="138" width="630" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p7_00_info" value="shard_rank = (0×2+0)×1+0 = 0  |  peer_port = 29000" style="text;html=1;align=center;fontSize=9;fontColor=#757575;strokeColor=none;fillColor=none;fontFamily=Courier New;" vertex="1" parent="p7_00">
                    <mxGeometry x="15" y="176" width="630" height="18" as="geometry"/>
                </mxCell>

                <!-- ===== DP1 / PP0 — Stage (1,0,0) ===== -->
                <mxCell id="p7_10" value="Stage (1,0,0) — scheduler_DP1_PP0" style="swimlane;startSize=24;fillColor=#fafafa;strokeColor=#1565c0;fontStyle=1;fontSize=12;rounded=1;" vertex="1" parent="1">
                    <mxGeometry x="900" y="160" width="660" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="p7_10_cache" value="L1: GPU VRAM (KV Pool)  →  L2: Host DRAM (HiCache backup_thread)" style="rounded=1;whiteSpace=wrap;fillColor=#dcedc8;strokeColor=#558b2f;fontSize=10;align=center;" vertex="1" parent="p7_10">
                    <mxGeometry x="15" y="32" width="630" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="p7_10_dkr" value="DecodeKVReplicator: on_decode_step → flush_page → GPU DMA → write_storage" style="rounded=1;whiteSpace=wrap;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=9;fontStyle=1;align=center;" vertex="1" parent="p7_10">
                    <mxGeometry x="15" y="68" width="630" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="p7_10_send" value="SEND ▸  PeerCacheClient → TCP (CMD_PUT_TOKENS) → Stage(0,0,0) :29000" style="rounded=1;whiteSpace=wrap;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="p7_10">
                    <mxGeometry x="15" y="100" width="630" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p7_10_recv" value="RECV ◂  PeerCacheServer :29002 ← from Stage(0,0,0)  |  PeerRadixBuffer (token trie, LRU)" style="rounded=1;whiteSpace=wrap;fillColor=#fff3e0;strokeColor=#ef6c00;fontSize=10;align=center;" vertex="1" parent="p7_10">
