                <mxCell id="p1_summary" value="Core idea: Add a third storage tier (L3: Peer DRAM) to HiCache via PeerCacheStorage, plus real-time decode backup via DecodeKVReplicator. DataParallelController gains internal failover: track per-request checkpoint/visible state, detect worker failure, resume on backup with ResumeGenerateReq." style="rounded=1;whiteSpace=wrap;fillColor=#fff8e1;strokeColor=#f9a825;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
                    <mxGeometry x="60" y="750" width="1310" height="56" as="geometry"/>
