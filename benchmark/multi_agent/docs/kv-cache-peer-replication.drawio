                <mxCell id="p4_tcp_bk" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#ef6c00;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="p4_tcp" target="p4_bk_recv">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4_note" value="Key design: Transport uses full_token_ids + page_start (not hash keys). Backup stores in a local token trie. No shared state required between owner and backup." style="rounded=1;whiteSpace=wrap;fillColor=#fff8e1;strokeColor=#f9a825;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
                    <mxGeometry x="180" y="700" width="1280" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p4_ann" value="Gray = reuses existing HiCache L1/L2 path from 0.5.9&#10;Green = NEW code added for peer replication" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#9e9e9e;fontSize=10;align=center;" vertex="1" parent="1">
                    <mxGeometry x="810" y="130" width="200" height="60" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram name="5. Internal DP Failover Flow" id="p5">
        <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p5_title" value="Internal DP Failover Flow (Entirely New in Agent Branch)" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1a237e;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="200" y="10" width="1400" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="p5_sub" value="SGLang 0.5.9 has no internal failover. This entire mechanism is new: DPC tracks per-request state, detects failures, and orchestrates resume on backup." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#616161;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="120" y="44" width="1560" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="p5_ph1" value="Phase 1: Normal Operation (Tracking)" style="swimlane;startSize=24;fillColor=#e8f5e9;strokeColor=#2e7d32;fontStyle=1;fontSize=13;rounded=1;" vertex="1" parent="1">
                    <mxGeometry x="40" y="80" width="1720" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="p5_req" value="Client request&#10;dispatched to&#10;owner dp_rank" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#9e9e9e;fontSize=10;align=center;" vertex="1" parent="p5_ph1">
                    <mxGeometry x="20" y="40" width="140" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="p5_track" value="DPC creates&#10;TrackedGenerateRequest&#10;owner=dp0, backup=dp1&#10;visible=[], checkpoint=0" style="rounded=1;whiteSpace=wrap;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="p5_ph1">
                    <mxGeometry x="190" y="34" width="200" height="66" as="geometry"/>
                </mxCell>
                <mxCell id="p5_decode" value="Owner scheduler processes&#10;prefill → decode iterations&#10;KV replicated to backup" style="rounded=1;whiteSpace=wrap;fillColor=#dcedc8;strokeColor=#558b2f;fontSize=10;align=center;" vertex="1" parent="p5_ph1">
                    <mxGeometry x="420" y="40" width="200" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="p5_ckpt" value="Last PP stage:&#10;CheckpointUpdateReq&#10;→ DPC updates&#10;checkpointed_output_len" style="rounded=1;whiteSpace=wrap;fillColor=#ffe0b2;strokeColor=#ef6c00;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="p5_ph1">
                    <mxGeometry x="660" y="34" width="200" height="66" as="geometry"/>
                </mxCell>
                <mxCell id="p5_vis" value="TokenizerManager:&#10;VisibleStateUpdateReq&#10;→ DPC extends&#10;visible_output_ids" style="rounded=1;whiteSpace=wrap;fillColor=#f3e5f5;strokeColor=#8e24aa;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="p5_ph1">
                    <mxGeometry x="900" y="34" width="200" height="66" as="geometry"/>
                </mxCell>
                <mxCell id="p5_state" value="DPC state per request:&#10;visible_output_ids = [t1,t2,...,tN]&#10;checkpointed_output_len = K (K≤N)&#10;(K = backed up in peer storage)" style="rounded=1;whiteSpace=wrap;fillColor=#fff8e1;strokeColor=#f9a825;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="p5_ph1">
                    <mxGeometry x="1140" y="34" width="260" height="66" as="geometry"/>
                </mxCell>
                <mxCell id="p5_repl" value="Meanwhile: each decode page&#10;→ DecodeKVReplicator&#10;→ GPU DMA → TCP → peer buffer" style="rounded=1;whiteSpace=wrap;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=10;align=center;" vertex="1" parent="p5_ph1">
                    <mxGeometry x="1440" y="34" width="240" height="66" as="geometry"/>
                </mxCell>
                <mxCell id="p5_pe1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#9e9e9e;strokeWidth=1;endArrow=block;endFill=1;" edge="1" parent="p5_ph1" source="p5_req" target="p5_track">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5_pe2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2e7d32;strokeWidth=1;endArrow=block;endFill=1;" edge="1" parent="p5_ph1" source="p5_track" target="p5_decode">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5_pe3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#ef6c00;strokeWidth=1;endArrow=block;endFill=1;" edge="1" parent="p5_ph1" source="p5_decode" target="p5_ckpt">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5_pe4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#8e24aa;strokeWidth=1;endArrow=block;endFill=1;" edge="1" parent="p5_ph1" source="p5_ckpt" target="p5_vis">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5_pe5" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#f9a825;strokeWidth=1;endArrow=block;endFill=1;" edge="1" parent="p5_ph1" source="p5_vis" target="p5_state">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5_pe6" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2e7d32;strokeWidth=1;endArrow=block;endFill=1;" edge="1" parent="p5_ph1" source="p5_state" target="p5_repl">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5_ph2" value="Phase 2: Failure Detection" style="swimlane;startSize=24;fillColor=#ffebee;strokeColor=#c62828;fontStyle=1;fontSize=13;rounded=1;" vertex="1" parent="1">
                    <mxGeometry x="40" y="310" width="700" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="p5_fail" value="Owner scheduler&#10;process exits&#10;(crash / kill)" style="rounded=1;whiteSpace=wrap;fillColor=#ffcdd2;strokeColor=#c62828;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="p5_ph2">
                    <mxGeometry x="20" y="40" width="160" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p5_poll" value="_poll_failed_worker_groups()&#10;detects subprocess exit&#10;status[dp_rank] = False" style="rounded=1;whiteSpace=wrap;fillColor=#ffcdd2;strokeColor=#c62828;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="p5_ph2">
                    <mxGeometry x="220" y="40" width="220" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p5_handle" value="_handle_failed_dp_rank()&#10;Collect all tracked requests&#10;for owner == failed_rank" style="rounded=1;whiteSpace=wrap;fillColor=#ffe0b2;strokeColor=#ef6c00;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="p5_ph2">
                    <mxGeometry x="480" y="40" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p5_fe1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#c62828;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="p5_ph2" source="p5_fail" target="p5_poll">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5_fe2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#ef6c00;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="p5_ph2" source="p5_poll" target="p5_handle">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5_ph3" value="Phase 3: Resume on Backup" style="swimlane;startSize=24;fillColor=#e3f2fd;strokeColor=#1565c0;fontStyle=1;fontSize=13;rounded=1;" vertex="1" parent="1">
                    <mxGeometry x="780" y="310" width="980" height="360" as="geometry"/>
                </mxCell>
                <mxCell id="p5_build" value="Build ResumeGenerateReq:&#10;effective_len = min(checkpointed_len,&#10;                      len(visible_ids))&#10;visible_output_ids[:effective_len]&#10;+ original tokenized_req&#10;+ failover_epoch" style="rounded=1;whiteSpace=wrap;fillColor=#ffe0b2;strokeColor=#ef6c00;fontSize=10;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="p5_ph3">
                    <mxGeometry x="20" y="40" width="280" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p5_send" value="DPC dispatches&#10;ResumeGenerateReq&#10;→ backup scheduler&#10;(dp1)" style="rounded=1;whiteSpace=wrap;fillColor=#ffe0b2;strokeColor=#ef6c00;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="p5_ph3">
                    <mxGeometry x="340" y="40" width="180" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p5_resume" value="Backup scheduler:&#10;handle_resume_generate_request()&#10;input_ids = orig + visible_output_ids&#10;adjust max_new_tokens&#10;is_failover_resume = True" style="rounded=1;whiteSpace=wrap;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=10;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="p5_ph3">
                    <mxGeometry x="560" y="36" width="280" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="p5_prefetch" value="Prefetch from local peer buffer:&#10;_should_prefetch_storage_for_req = True&#10;PeerRadixBuffer.match_prefix_from()&#10;→ get_pages_by_tokens()&#10;→ restore KV to Host L2 → GPU L1" style="rounded=1;whiteSpace=wrap;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=10;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="p5_ph3">
                    <mxGeometry x="20" y="170" width="300" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="p5_pp_gate" value="PP gating (scheduler_pp_mixin):&#10;When PP&gt;1, non-first stages wait&#10;for prefetch completion before&#10;forwarding to next PP stage" style="rounded=1;whiteSpace=wrap;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="p5_ph3">
                    <mxGeometry x="360" y="170" width="260" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="p5_gen" value="Resume generation&#10;from visible output boundary&#10;(user sees seamless continuation)" style="rounded=1;whiteSpace=wrap;fillColor=#dcedc8;strokeColor=#558b2f;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="p5_ph3">
                    <mxGeometry x="660" y="170" width="280" height="66" as="geometry"/>
                </mxCell>
                <mxCell id="p5_policy" value="Prefetch policy controls resume behavior:&#10;wait_complete: wait for all pages fetched&#10;best_effort: proceed with partial data&#10;timeout: wait up to budget, then proceed" style="rounded=1;whiteSpace=wrap;fillColor=#fff8e1;strokeColor=#f9a825;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="p5_ph3">
                    <mxGeometry x="190" y="278" width="340" height="66" as="geometry"/>
                </mxCell>
