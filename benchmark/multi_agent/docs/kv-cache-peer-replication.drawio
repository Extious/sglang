                </mxCell>
                <mxCell id="p2_sub" value="Both prefill and decode KV pages are replicated asynchronously to neighbor (zero inference latency impact)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#616161;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="200" y="42" width="1200" height="22" as="geometry"/>
