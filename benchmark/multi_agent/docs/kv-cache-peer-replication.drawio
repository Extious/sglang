                <mxCell id="p6_enable_d" value="deploy_server: --enable-peer-replication&#10;  → auto-sets worker + router flags&#10;&#10;SGLang Worker: --hicache-storage-backend peer&#10;  → starts PeerCacheServer + PeerCacheStorage&#10;  → creates DecodeKVReplicator in HiRadixCache&#10;&#10;PythonRouter: --enable-fault-tolerance&#10;  → activates ring failover strategy" style="rounded=1;whiteSpace=wrap;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=9;align=left;spacingLeft=8;fontFamily=Courier New;" parent="p6_config" vertex="1">
                    <mxGeometry x="10" y="48" width="350" height="140" as="geometry"/>
