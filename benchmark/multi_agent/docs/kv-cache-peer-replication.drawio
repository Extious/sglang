                    <mxGeometry x="40" y="930" width="1520" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p7_proto_d" value="CMD_PUT_TOKENS(4): [cmd:1B][seq_len:4B][page_start:4B][page_count:4B] + [tokens: seq_len×4B LE u32] + [per page: data_len:4B + data] → Response: [status:1B][count:4B] + [success: bool×count]" style="text;html=1;align=left;fontSize=9;fontColor=#bf360c;strokeColor=none;fillColor=none;fontFamily=Courier New;spacingLeft=8;" vertex="1" parent="p7_proto">
