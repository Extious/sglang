                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_e2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#333;strokeWidth=2;endArrow=block;endFill=1;" parent="p2_w0" source="p2_s2" target="p2_s3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_e3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#558b2f;strokeWidth=2;endArrow=block;endFill=1;" parent="p2_w0" source="p2_l2" target="p2_ctrl" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
