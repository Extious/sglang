                <!-- ===== Key principle note ===== -->
                <mxCell id="p7_note" value="Key: No PP-to-PP replication. Each PP stage only backs up to the SAME pp_rank on backup DP. Transport uses full_token_ids + page_start (not hash keys). Token-indexed trie enables failover without shared state." style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#9e9e9e;fontSize=10;align=left;spacingLeft=12;" vertex="1" parent="1">
                    <mxGeometry x="40" y="880" width="1520" height="36" as="geometry"/>
