                <mxCell id="p4_tcp_e2" value="decode backup" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#ef6c00;strokeWidth=3;endArrow=block;endFill=1;fontSize=9;fontColor=#ef6c00;" edge="1" parent="1" source="p4_dc5" target="p4_tcp">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4_backup" value="Backup Stage (dp1/pp0/tp0)" style="swimlane;startSize=26;fillColor=#fafafa;strokeColor=#424242;fontStyle=1;fontSize=14;rounded=1;" vertex="1" parent="1">
                    <mxGeometry x="1040" y="90" width="420" height="580" as="geometry"/>
                </mxCell>
                <mxCell id="p4_bk_recv" value="NEW: PeerCacheServer&#10;TCP listener" style="rounded=1;whiteSpace=wrap;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="p4_backup">
                    <mxGeometry x="30" y="50" width="360" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p4_bk_insert" value="NEW: insert_tokens()&#10;→ PeerRadixBuffer.insert_pages()" style="rounded=1;whiteSpace=wrap;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="p4_backup">
                    <mxGeometry x="30" y="130" width="360" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p4_bk_trie" value="NEW: PeerRadixBuffer&#10;Token-indexed trie&#10;LRU eviction&#10;max_size = peer_buffer_size_gb" style="rounded=1;whiteSpace=wrap;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="p4_backup">
                    <mxGeometry x="30" y="210" width="360" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p4_bk_sep" value="──── On failover resume ────" style="text;html=1;align=center;fontSize=11;fontStyle=1;fontColor=#c62828;strokeColor=none;fillColor=none;" vertex="1" parent="p4_backup">
                    <mxGeometry x="30" y="310" width="360" height="22" as="geometry"/>
