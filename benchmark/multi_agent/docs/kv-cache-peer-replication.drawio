                <mxCell id="p6_ph6" value="PythonRouter&#10;Ring failover strategy&#10;--enable-fault-tolerance&#10;select_worker(failed_idx)" style="rounded=1;whiteSpace=wrap;fillColor=#e1bee7;strokeColor=#7b1fa2;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="p6_phases">
                    <mxGeometry x="1045" y="28" width="195" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p6_ph7" value="HiRadixCache &amp;&#10;Scheduler Integration&#10;writing_check()&#10;process_batch_result" style="rounded=1;whiteSpace=wrap;fillColor=#e1bee7;strokeColor=#7b1fa2;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="p6_phases">
