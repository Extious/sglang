                <mxCell id="s_dataflow" value="Data Flow (fully async, zero inference latency):&#10;  Prefill:  GPU → CPU (L2) → backup_thread → PeerCacheStorage.batch_set_v1() → TCP → Neighbor's buffer&#10;  Decode:  GPU → DecodeKVReplicator → page flush → GPU→Host DMA → write_storage() → TCP → Neighbor's buffer" style="rounded=1;whiteSpace=wrap;fillColor=#e8f5e9;strokeColor=#1b5e20;fontSize=10;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="560" width="720" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="s_failover" value="Failover:  Wi fails → Router detects → route to W(i+1)%N&#10;  W(i+1) has Wi's KV in PeerBuffer → restore to L2 → L1 → resume&#10;  Recovery: seconds → milliseconds  (no re-prefill needed)" style="rounded=1;whiteSpace=wrap;fillColor=#fff3e0;strokeColor=#e65100;fontSize=10;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="635" width="720" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="s_key" value="Key Insight:  Write → REMOTE neighbor  |  Read → LOCAL buffer" style="rounded=1;whiteSpace=wrap;fillColor=#1a237e;strokeColor=none;fontSize=12;fontStyle=1;fontColor=#ffffff;align=center;" parent="1" vertex="1">
                    <mxGeometry x="40" y="705" width="720" height="32" as="geometry"/>
                </mxCell>
