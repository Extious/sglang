                <mxCell id="p4_vs1" value="TokenizerManager:&#10;Each decode output batch&#10;→ VisibleStateUpdateReq(delta_ids, finished)&#10;→ DPC" style="rounded=1;whiteSpace=wrap;fillColor=#f3e5f5;strokeColor=#8e24aa;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="p4_owner">
