                <mxCell id="p4_vs_title" value="VISIBLE STATE TRACKING (via NEW tokenizer extension)" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#8e24aa;strokeColor=none;fillColor=none;" vertex="1" parent="p4_owner">
                    <mxGeometry x="20" y="490" width="500" height="22" as="geometry"/>
