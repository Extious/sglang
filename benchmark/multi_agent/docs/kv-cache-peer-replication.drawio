                <mxCell id="p3_sub" value="Blue boxes = existing modules with additions. Green text = what was specifically added for peer replication." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#616161;strokeColor=none;fillColor=none;" parent="1" vertex="1">
