                <mxCell id="p3_hrc" value="hiradix_cache.py (+264 lines)" style="swimlane;startSize=22;fillColor=#e3f2fd;strokeColor=#1565c0;fontStyle=1;fontSize=12;rounded=1;" vertex="1" parent="1">
                    <mxGeometry x="590" y="430" width="520" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="p3_hrc_d" value="Checkpoint tracking:&#10;  local_checkpointed_output_lens: Dict[str, int]&#10;  pending_checkpoint_rids: deque&#10;  update_local_checkpointed_output_len()&#10;  pop_pending_checkpoint_rids()&#10;  clear_request_checkpoint_state()&#10;&#10;Peer prefetch integration:&#10;  prefetch_from_storage() with token path&#10;  check_prefetch_progress() + pop_prefetch_loaded_tokens()&#10;  get_prefetch_anchor_for_req()&#10;&#10;Peer storage default: prefetch_stop_policy = wait_complete&#10;&#10;Log annotations: mark L3 (peer DRAM) loads" style="rounded=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=10;align=left;spacingLeft=8;spacingTop=2;" vertex="1" parent="p3_hrc">
