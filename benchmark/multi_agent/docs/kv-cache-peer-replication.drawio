                <mxCell id="p6_ph5" value="Peer Discovery&#10;deploy_server.py&#10;peer mapping + URLs&#10;peer_mapping.txt" style="rounded=1;whiteSpace=wrap;fillColor=#e1bee7;strokeColor=#7b1fa2;fontSize=10;fontStyle=1;align=center;" parent="p6_phases" vertex="1">
