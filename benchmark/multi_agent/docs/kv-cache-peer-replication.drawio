    <diagram name="2. New Modules Detail" id="p2">
        <mxGraphModel dx="1348" dy="986" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p2_title" value="New Modules Added for Peer Replication (4 files, +1249 lines)" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1a237e;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="200" y="10" width="1400" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="p2_sub" value="These files did not exist in SGLang 0.5.9. All are entirely new additions on the agent branch." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#616161;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="200" y="44" width="1400" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="p2_srv" value="peer_cache_server.py (555 lines)" style="swimlane;startSize=24;fillColor=#e8f5e9;strokeColor=#2e7d32;fontStyle=1;fontSize=13;rounded=1;" vertex="1" parent="1">
                    <mxGeometry x="40" y="90" width="830" height="420" as="geometry"/>
                </mxCell>
                <mxCell id="p2_srv_d" value="Purpose: TCP server for receiving replicated KV pages + local radix-trie storage" style="rounded=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=10;fontColor=#616161;align=left;spacingLeft=8;" vertex="1" parent="p2_srv">
                    <mxGeometry x="10" y="28" width="810" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="p2_prb" value="PeerRadixBuffer" style="swimlane;startSize=20;fillColor=#c8e6c9;strokeColor=#2e7d32;fontStyle=1;fontSize=12;rounded=1;" vertex="1" parent="p2_srv">
                    <mxGeometry x="10" y="55" width="390" height="330" as="geometry"/>
                </mxCell>
                <mxCell id="p2_prb_d" value="_TrieNode: children dict + kv_data bytes + data_size + page_id&#10;&#10;insert_pages(full_token_ids, page_start, kv_pages)&#10;  └ Walk trie from root to page_start, then insert per-page&#10;  └ LRU eviction when exceeding max_size_bytes&#10;&#10;match_prefix_from(token_ids, start_page)&#10;  └ Returns (data_count, navigable_range)&#10;  └ data_count = pages with actual KV data&#10;  └ navigable_range = contiguous trie depth&#10;&#10;get_pages(token_ids, page_start, page_count)&#10;  └ Returns list of KV data bytes&#10;&#10;Key design: Token-indexed trie, NOT hash-based&#10;  → No shared hash alignment needed between workers&#10;  → Backup stores by full token sequence" style="rounded=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=10;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="p2_prb">
                    <mxGeometry x="6" y="24" width="378" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="p2_pcs" value="PeerCacheServer" style="swimlane;startSize=20;fillColor=#c8e6c9;strokeColor=#2e7d32;fontStyle=1;fontSize=12;rounded=1;" vertex="1" parent="p2_srv">
                    <mxGeometry x="420" y="55" width="390" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="p2_pcs_d" value="ThreadingTCPServer + PeerRadixBuffer + Lock&#10;&#10;start() → daemon thread listening on port&#10;stop() → shutdown()&#10;insert_tokens() → lock + buffer.insert_pages()&#10;match_prefix_from() → lock + buffer query&#10;get_pages_by_tokens() → lock + buffer.get_pages()" style="rounded=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=10;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="p2_pcs">
                    <mxGeometry x="6" y="22" width="378" height="132" as="geometry"/>
                </mxCell>
                <mxCell id="p2_pcc" value="PeerCacheClient" style="swimlane;startSize=20;fillColor=#c8e6c9;strokeColor=#2e7d32;fontStyle=1;fontSize=12;rounded=1;" vertex="1" parent="p2_srv">
                    <mxGeometry x="420" y="230" width="390" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="p2_pcc_d" value="TCP client connecting to remote PeerCacheServer&#10;&#10;put_pages_tokens(full_token_ids, page_start, kv_pages)&#10;  └ Wire: CMD_PUT_TOKENS(4) + seq_len + page_start&#10;     + page_count + token_ids + page_data&#10;  └ Response: status + per-page success booleans&#10;&#10;Cooldown: 2 failures → 15s cooldown before retry" style="rounded=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=10;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="p2_pcc">
                    <mxGeometry x="6" y="22" width="378" height="122" as="geometry"/>
                </mxCell>
                <mxCell id="p2_sto" value="peer_cache_storage.py (338 lines)" style="swimlane;startSize=24;fillColor=#e8f5e9;strokeColor=#2e7d32;fontStyle=1;fontSize=13;rounded=1;" vertex="1" parent="1">
                    <mxGeometry x="900" y="90" width="440" height="420" as="geometry"/>
                </mxCell>
                <mxCell id="p2_sto_d" value="Purpose: HiCacheStorage backend implementing DP-ring peer replication" style="rounded=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=10;fontColor=#616161;align=left;spacingLeft=8;" vertex="1" parent="p2_sto">
                    <mxGeometry x="10" y="28" width="420" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="p2_sto_cls" value="PeerCacheStorage(HiCacheStorage)" style="rounded=1;whiteSpace=wrap;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="p2_sto">
                    <mxGeometry x="20" y="56" width="400" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p2_sto_methods" value="Ring topology:&#10;  backup_dp_rank = (dp_rank + 1) % dp_size&#10;  target = (backup_dp_rank, same pp_rank, same tp_rank)&#10;&#10;Port calculation:&#10;  shard_rank = (dp*pp_size + pp)*tp_size + tp&#10;  port = peer_port_base + shard_rank&#10;&#10;Write path (batch_set_v1):&#10;  Serialize from mem_pool_host →&#10;  PeerCacheClient.put_pages_tokens() → TCP → peer&#10;&#10;Read path (batch_get_v1 + match_prefix_from):&#10;  Query LOCAL PeerCacheServer trie&#10;  (data was replicated FROM the failed owner)&#10;&#10;Config: peer_port, peer_targets, peer_url,&#10;  peer_buffer_size_gb, SGLANG_PEER_CACHE_PORT env" style="rounded=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=10;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="p2_sto">
                    <mxGeometry x="20" y="94" width="400" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="p2_dkr" value="decode_kv_replicator.py (352 lines)" style="swimlane;startSize=24;fillColor=#e8f5e9;strokeColor=#2e7d32;fontStyle=1;fontSize=13;rounded=1;" vertex="1" parent="1">
                    <mxGeometry x="40" y="540" width="830" height="360" as="geometry"/>
                </mxCell>
                <mxCell id="p2_dkr_d" value="Purpose: Real-time backup of decode-phase KV pages that have NOT yet entered the radix tree" style="rounded=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=10;fontColor=#616161;align=left;spacingLeft=8;" vertex="1" parent="p2_dkr">
                    <mxGeometry x="10" y="28" width="810" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="p2_dkr_flow" value="Decode KV Backup Pipeline" style="swimlane;startSize=18;fillColor=#c8e6c9;strokeColor=#2e7d32;fontStyle=1;fontSize=11;rounded=1;" vertex="1" parent="p2_dkr">
                    <mxGeometry x="10" y="56" width="810" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="p2_df1" value="1. on_decode_step()&#10;accumulate tokens" style="rounded=1;whiteSpace=wrap;fillColor=#dcedc8;strokeColor=#558b2f;fontSize=9;align=center;" vertex="1" parent="p2_dkr_flow">
                    <mxGeometry x="10" y="28" width="130" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p2_df2" value="2. _flush_page()&#10;align to page_size" style="rounded=1;whiteSpace=wrap;fillColor=#dcedc8;strokeColor=#558b2f;fontSize=9;align=center;" vertex="1" parent="p2_dkr_flow">
                    <mxGeometry x="160" y="28" width="130" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p2_df3" value="3. HiCacheController.write()&#10;GPU → Host DMA" style="rounded=1;whiteSpace=wrap;fillColor=#dcedc8;strokeColor=#558b2f;fontSize=9;align=center;" vertex="1" parent="p2_dkr_flow">
                    <mxGeometry x="310" y="28" width="150" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p2_df4" value="4. on_write_complete()&#10;→ write_storage()" style="rounded=1;whiteSpace=wrap;fillColor=#ffe0b2;strokeColor=#ef6c00;fontSize=9;fontStyle=1;align=center;" vertex="1" parent="p2_dkr_flow">
                    <mxGeometry x="480" y="28" width="140" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p2_df5" value="5. on_backup_complete()&#10;update checkpoint len" style="rounded=1;whiteSpace=wrap;fillColor=#ffe0b2;strokeColor=#ef6c00;fontSize=9;fontStyle=1;align=center;" vertex="1" parent="p2_dkr_flow">
                    <mxGeometry x="640" y="28" width="150" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p2_dfe1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2e7d32;strokeWidth=1;endArrow=block;endFill=1;" edge="1" parent="p2_dkr_flow" source="p2_df1" target="p2_df2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_dfe2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2e7d32;strokeWidth=1;endArrow=block;endFill=1;" edge="1" parent="p2_dkr_flow" source="p2_df2" target="p2_df3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_dfe3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#ef6c00;strokeWidth=1;endArrow=block;endFill=1;" edge="1" parent="p2_dkr_flow" source="p2_df3" target="p2_df4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_dfe4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#ef6c00;strokeWidth=1;endArrow=block;endFill=1;" edge="1" parent="p2_dkr_flow" source="p2_df4" target="p2_df5">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_dkr_cls" value="DecodeKVReplicator key internals" style="swimlane;startSize=18;fillColor=#c8e6c9;strokeColor=#2e7d32;fontStyle=1;fontSize=11;rounded=1;" vertex="1" parent="p2_dkr">
                    <mxGeometry x="10" y="180" width="810" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="p2_dkr_det" value="_ReqState: per-request accumulator (tokens, device_indices, parent_hash, pages_flushed, origin_input_ids, flushed_token_ids)&#10;_PendingPage: page awaiting DMA completion (hash, host_indices, node_id, rid, full_token_ids, page_start, checkpoint_output_len)&#10;_PendingStorage: page awaiting storage backup completion (rid, host_indices, checkpoint_output_len)&#10;&#10;set_prefill_parent_hash(): captures prefill final page hash as decode hash chain starting point&#10;on_request_finished(): cleans up state; force_release_pending_storage(): shutdown protection&#10;&#10;Bypasses radix tree for in-flight decode pages; uses negative node_id to avoid collision with main tree" style="rounded=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=10;align=left;spacingLeft=8;spacingTop=2;" vertex="1" parent="p2_dkr_cls">
                    <mxGeometry x="6" y="22" width="798" height="122" as="geometry"/>
                </mxCell>
                <mxCell id="p2_fel" value="failover_event_logger.py" style="swimlane;startSize=24;fillColor=#e8f5e9;strokeColor=#2e7d32;fontStyle=1;fontSize=13;rounded=1;" vertex="1" parent="1">
                    <mxGeometry x="900" y="540" width="440" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="p2_fel_d" value="Purpose: Optional JSONL audit log for failover events&#10;&#10;append_failover_event(event, **payload)&#10;  └ If SGLANG_FAILOVER_EVENTS_FILE env set:&#10;     write JSON line with UTC timestamp + payload&#10;  └ fcntl file lock for multi-process safety&#10;&#10;Called from: scheduler.py, data_parallel_controller.py&#10;Used for debugging and experiment analysis" style="rounded=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=10;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="p2_fel">
                    <mxGeometry x="10" y="28" width="420" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="p2_wire" value="TCP Wire Protocol (CMD_PUT_TOKENS = 4)" style="swimlane;startSize=22;fillColor=#fff3e0;strokeColor=#ef6c00;fontStyle=1;fontSize=12;rounded=1;" vertex="1" parent="1">
                    <mxGeometry x="900" y="750" width="440" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="p2_wire_d" value="Client sends:&#10;  [cmd:1B][seq_len:4B][page_start:4B][page_count:4B]&#10;  [tokens: seq_len × 4B LE uint32]&#10;  [per page: data_len:4B + data bytes]&#10;&#10;Server responds:&#10;  [status:1B][count:4B]&#10;  [per page: success:1B boolean]" style="rounded=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=10;spacingTop=2;" vertex="1" parent="p2_wire">
                    <mxGeometry x="6" y="26" width="428" height="118" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
