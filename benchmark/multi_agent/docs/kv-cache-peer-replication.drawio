                <mxCell id="p4_dc_title" value="DECODE PATH (via NEW DecodeKVReplicator)" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#1565c0;strokeColor=none;fillColor=none;" vertex="1" parent="p4_owner">
                    <mxGeometry x="20" y="150" width="500" height="22" as="geometry"/>
