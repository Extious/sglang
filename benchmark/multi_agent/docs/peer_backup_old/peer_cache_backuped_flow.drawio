        <mxCell id="lg1" value="Blue = general step" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1976D2;fontSize=9;fontColor=#1565C0;" vertex="1" parent="1">
