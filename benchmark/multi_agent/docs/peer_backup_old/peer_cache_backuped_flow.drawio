        <!-- ===== CROSS-LANE EDGES ===== -->
        <mxCell id="cx1" value="prompt pages in B's local buffer" style="edgeStyle=orthogonalEdgeStyle;dashed=1;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#6A1B9A;fontColor=#6A1B9A;fontSize=9;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pwBuf" target="fo8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cx2" value="decode pages in B's local buffer" style="edgeStyle=orthogonalEdgeStyle;dashed=1;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#3949AB;fontColor=#3949AB;fontSize=9;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.65;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dwBuf" target="fo8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== SUMMARY ===== -->
        <mxCell id="summary" value="Root causes for low peer cache hit rate and applied fixes:&#xa;&#xa;1. write_through_selective threshold = 2: unique prompt prefixes need 2 hits before backup. First-time user prompts are not backed up.&#xa;2. &#x2605; Decode host memory leak (FIXED): on_write_complete() now tracks host_indices in _pending_storage; _drain_backup() frees them&#xa;    via on_backup_complete(). Previously host pool exhausted silently, causing decode flushes to be skipped.&#xa;3. &#x2605; Fragile decode hash anchor (FIXED): set_prefill_parent_hash() was dead code. Now called in process_batch_result_prefill()&#xa;    to pin parent_hash immediately, avoiding stale anchor from evicted radix nodes.&#xa;4. batch_exists() consecutive-hit requirement: first missing page stops the scan. One gap in decode pages = 0 decode hits." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#546E7A;fontSize=11;fontColor=#37474F;align=left;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1035" width="1060" height="145" as="geometry" />
        </mxCell>

