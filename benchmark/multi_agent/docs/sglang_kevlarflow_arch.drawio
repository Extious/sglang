                </mxCell>
                <mxCell id="mem4" value="丢弃 LOW (3) 优先级的复制任务" style="rounded=1;whiteSpace=wrap;fillColor=#ffe0b2;strokeColor=#ff9800;fontSize=10;align=center;" parent="mem" vertex="1">
                    <mxGeometry x="20" y="140" width="250" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="mem5" value="丢弃 BACKGROUND (4) 优先级的复制任务" style="rounded=1;whiteSpace=wrap;fillColor=#ffe0b2;strokeColor=#ff9800;fontSize=10;align=center;" parent="mem" vertex="1">
                    <mxGeometry x="280" y="140" width="280" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="mem6" value="保留 CRITICAL / HIGH / NORMAL" style="rounded=1;whiteSpace=wrap;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=10;align=center;fontStyle=1;" parent="mem" vertex="1">
                    <mxGeometry x="20" y="195" width="540" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="mem7" value="为什么可以丢弃?&#10;&#10;Prefill KV 已在 rank 0 上完整存在&#10;replicated KV 只是备援，不影响推理正确性&#10;下次 decode 触发时重新复制即可" style="rounded=1;whiteSpace=wrap;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=10;align=left;spacingLeft=8;spacingTop=4;" parent="mem" vertex="1">
                    <mxGeometry x="20" y="250" width="540" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="back" value="Background 复制与备援机制" style="swimlane;startSize=26;fillColor=#ede7f6;strokeColor=#5c6bc0;fontStyle=1;fontSize=13;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="1470" y="765" width="490" height="350" as="geometry"/>
                </mxCell>
                <mxCell id="back1" value="为什么后台复制?&#10;&#10;推理延迟敏感，不能阻塞主计算&#10;KV 复制对 TTFT/Latency 无感知影响&#10;GPU 利用率约 50-60%，有充足余量" style="rounded=1;whiteSpace=wrap;fillColor=#ede7f6;strokeColor=#5c6bc0;fontSize=10;align=left;spacingLeft=8;spacingTop=4;" parent="back" vertex="1">
                    <mxGeometry x="20" y="45" width="440" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="back2" value="为什么是 Rank 0?&#10;&#10;Rank 0 是 prefill/decode 的主节点&#10;所有 KV 都在 Rank 0 首先生成&#10;其他 rank 从 rank 0 拉取 (pull model)" style="rounded=1;whiteSpace=wrap;fillColor=#c5cae9;strokeColor=#3f51b5;fontSize=10;align=left;spacingLeft=8;spacingTop=4;" parent="back" vertex="1">
                    <mxGeometry x="20" y="160" width="440" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="back3" value="ring-shaped 复制:&#10;多个 backup rank 组成 ring，分布式持有 KV 副本&#10;支持多节点同时故障的恢复" style="rounded=1;whiteSpace=wrap;fillColor=#d1c4e9;strokeColor=#512da8;fontSize=10;align=left;spacingLeft=8;spacingTop=4;" parent="back" vertex="1">
                    <mxGeometry x="20" y="275" width="440" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="sum3" value="总结: KV 管理核心设计" style="swimlane;startSize=26;fillColor=#eceff1;strokeColor=#455a64;fontStyle=1;fontSize=13;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1135" width="2920" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="s3_1" value="传输时机:&#10;Prefill 完成 (CRITICAL)&#10;Decode 步骤 (NORMAL)&#10;每 N 步可选 (stage_kv_sync_every_n_steps)" style="rounded=1;whiteSpace=wrap;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=10;align=left;spacingLeft=8;spacingTop=4;" parent="sum3" vertex="1">
                    <mxGeometry x="20" y="45" width="280" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="s3_2" value="传输方式:&#10;Dedicated CUDA Stream (非阻塞)&#10;Chunk=32 tokens 分块&#10;优先级队列排序&#10;stage_replica_group NCCL 广播" style="rounded=1;whiteSpace=wrap;fillColor=#e8f5e9;strokeColor=#4caf50;fontSize=10;align=left;spacingLeft=8;spacingTop=4;" parent="sum3" vertex="1">
                    <mxGeometry x="320" y="45" width="280" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="s3_3" value="内存管理:&#10;内存压力阈值 10%&#10;丢弃 LOW/BACKGROUND 任务&#10;保留 CRITICAL/HIGH/NORMAL" style="rounded=1;whiteSpace=wrap;fillColor=#fff3e0;strokeColor=#ff9800;fontSize=10;align=left;spacingLeft=8;spacingTop=4;" parent="sum3" vertex="1">
                    <mxGeometry x="620" y="45" width="280" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="s3_4" value="恢复机制:&#10;从 replicated KV 恢复推理&#10;无需从头重试&#10;去重避免重复处理&#10;用户无感知 session 完整" style="rounded=1;whiteSpace=wrap;fillColor=#fce4ec;strokeColor=#c2185b;fontSize=10;align=left;spacingLeft=8;spacingTop=4;" parent="sum3" vertex="1">
                    <mxGeometry x="920" y="45" width="280" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="s3_5" value="性能指标:&#10;运行时开销 less than 4%&#10;(实验数据，8 节点 / 16 节点)&#10;MTTR 30s vs 10min&#10;MTTR 提升 20x" style="rounded=1;whiteSpace=wrap;fillColor=#ede7f6;strokeColor=#5c6bc0;fontSize=10;align=left;spacingLeft=8;spacingTop=4;" parent="sum3" vertex="1">
                    <mxGeometry x="1220" y="45" width="280" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="s3_6" value="参考代码:&#10;fault_tolerance/fault_detector.py&#10;fault_tolerance/async_kv_replicator.py&#10;fault_tolerance/communicator_rebuilder.py&#10;fault_tolerance/request_recovery.py&#10;distributed/stage_kv_replica.py" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#9e9e9e;fontSize=9;align=left;spacingLeft=8;spacingTop=4;dashed=1;" parent="sum3" vertex="1">
                    <mxGeometry x="1520" y="45" width="380" height="110" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
