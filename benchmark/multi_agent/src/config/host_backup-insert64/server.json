    "hicache_size_gb": 60,
    "tool_call_parser": "qwen",
    "enable_cache_report": true,
    "enable_hicache": true,
    "hicache_ratio": 1.1,
    "insert_step": 64,
    "quantization": ""
  },
  "hicache_storage": {
    "backend": "",
    "prefetch_policy": ""
  }
}
