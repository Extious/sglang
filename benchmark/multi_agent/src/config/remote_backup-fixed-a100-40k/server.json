{
  "name": "remote_backup-fixed",
  "description": "SGLang server with Qwen3-8B + YaRN-scaled 200K context and remote backup for fixed-length, non-agent requests.",
  "platform": "daai",
  "kv_backup": "remote_backup",
  "server": {
    "model_path": "Qwen/Qwen3-8B",
    "server_port_base": 28300,
    "load_balance_method": "round_robin",
    "dp_size": 2,
    "pp_size": 1,
    "tp_size": 1,
    "nnodes": 1,
    "hicache_size_gb": 60,
    "tool_call_parser": "qwen",
    "context_length": 200000,
    "json_model_override_args": "{\"max_position_embeddings\": 200000, \"rope_theta\": 1000000, \"rope_scaling\": {\"rope_type\": \"yarn\", \"factor\": 4.8828125, \"original_max_position_embeddings\": 40960, \"rope_theta\": 1000000}}",
    "retry_queue_same_priority_as_waiting": true,
    "enable_cache_report": true,
    "enable_hicache": true,
    "hicache_ratio": 1.1,
    "quantization": ""
  },
  "hicache_storage": {
    "backend": "remote_backup",
    "prefetch_policy": "wait_complete",
    "remote_backup_port_base": 31000,
    "remote_backup_buffer_size_gb": 120
  }
}
