{
    "name": "remote_backup",
    "description": "SGLang server with remote host backup for automatic KV cache failover.",
    "platform": "daai",
    "kv_backup": "remote_backup",
    "server": {
        "model_path": "Qwen/Qwen3-8B",
        "load_balance_method": "round_robin",
        "dp_size": 4,
        "pp_size": 1,
        "tp_size": 1,
        "nnodes": 1,
        "hicache_size_gb": 40,
        "tool_call_parser": "qwen",
        "enable_cache_report": true,
        "enable_hicache": true,
        "hicache_ratio": 1.1,
        "quantization": ""
    },
    "hicache_storage": {
        "backend": "remote_backup",
        "prefetch_policy": "wait_complete",
        "remote_backup_port_base": 30000,
        "remote_backup_buffer_size_gb": 300
    }
}
